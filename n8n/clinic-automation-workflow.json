        "message": "=<!DOCTYPE html><html><body style=\"font-family:sans-serif;background:#FCF3F5;padding:24px;\"><div style=\"max-width:600px;margin:auto;background:#fff;border-radius:16px;padding:32px;border:1px solid #F2C0CD;\"><h1 style=\"color:#8B1E3F;margin:0 0 8px;\">Daily Appointment Report</h1><p style=\"color:#71717A;\">Date: {{ $now.format('DD MMMM YYYY') }} | Time: 9:00 PM IST</p><div style=\"display:flex;gap:12px;margin:24px 0;\"><div style=\"flex:1;background:#F9E6EB;padding:16px;border-radius:12px;text-align:center;\"><h2 style=\"color:#8B1E3F;margin:0;font-size:28px;\">52</h2><p style=\"color:#63152C;margin:4px 0 0;font-weight:600;\">Booked</p></div><div style=\"flex:1;background:#FEF2F2;padding:16px;border-radius:12px;text-align:center;\"><h2 style=\"color:#EF4444;margin:0;font-size:28px;\">2</h2><p style=\"color:#991B1B;margin:4px 0 0;font-weight:600;\">Cancelled</p></div><div style=\"flex:1;background:#F0FDF4;padding:16px;border-radius:12px;text-align:center;\"><h2 style=\"color:#10B981;margin:0;font-size:28px;\">14</h2><p style=\"color:#166534;margin:4px 0 0;font-weight:600;\">Upcoming Tomorrow</p></div></div><p style=\"color:#1B1B1F;line-height:1.6;\">⚡ <strong>Efficiency Metric:</strong> 5.5 hours saved today. 100% WhatsApp responses under 5 seconds. Zero double-bookings.</p><hr style=\"border:none;border-top:1px solid #F2C0CD;margin:24px 0;\"/><p style=\"font-size:12px;color:#A1A1AA;text-align:center;\">Generated automatically by Clinic Automation Pipeline &bull; n8n + Meta Cloud API</p></div></body></html>"
      },
