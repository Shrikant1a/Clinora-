          "id": "google-calendar-clinic-cred",
          "name": "Google Calendar Clinic Account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $items().length }}",
              "operation": "equal",
              "value2": 0
            }
          ]
        }
      },
      "id": "node-9-if-slot-free",
      "name": "9. IF Slot is Truly Free",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1240, 400]
