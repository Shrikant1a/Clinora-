{
  "name": "Clinora - WhatsApp Appointment Booking Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "responseMode": "onReceived",
        "responseData": "allEntries",
        "options": {
          "rawBody": true
        }
      },
      "id": "node-1-whatsapp-webhook",
      "name": "1. WhatsApp Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [100, 300],
      "webhookId": "clinic-whatsapp-inbound"
    },
    {
      "parameters": {
        "operation": "lookup",
        "sheetId": "={{ $env.GOOGLE_SHEETS_SPREADSHEET_ID }}",
        "range": "Conversations!A:E",
        "lookupColumn": "phone",
        "lookupValue": "={{ $json.body.entry[0].changes[0].value.messages[0].from }}",
        "options": {}
      },
      "id": "node-2-sheets-get-state",
      "name": "2. Google Sheets: Get Conversation State",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4,
      "position": [320, 300],
      "credentials": {
        "googleSheetsOAuth2": {
          "id": "google-sheets-clinic-cred",
          "name": "Google Sheets Clinic Account"
        }
      }
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "options": {
          "temperature": 0.2,
          "responseFormat": "json_object"
        },
        "systemMessage": "You are the WhatsApp booking assistant for Dr. Mehta Family Clinic.\nLanguages: reply in the patient's language (English, Hindi, Hinglish).\nGoal: book a doctor appointment. Collect: patient_name, problem, preferred_date, doctor (optional).\nRules:\n- Never give medical advice or diagnosis.\n- If the patient describes an emergency, output intent: 'escalate'.\n- Do not invent available times. Return intent 'book' or 'choose_slot'.\n- Keep replies under 3 short sentences.\nOutput ONLY valid JSON: {\"intent\":\"book|choose_slot|cancel|reschedule|info|escalate\", \"patient_name\":null, \"problem\":null, \"preferred_date\":null, \"doctor\":null, \"chosen_slot\":null, \"reply\":\"text\"}",
        "prompt": "Incoming message: {{ $('1. WhatsApp Webhook Trigger').item.json.body.entry[0].changes[0].value.messages[0].text.body }}\nCurrent state: {{ $json.state || 'NEW' }}\nCollected data: {{ $json.collected_json || '{}' }}"
      },
      "id": "node-3-openai-agent",
      "name": "3. OpenAI AI Agent (Hinglish/English)",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.3,
      "position": [540, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-clinic-cred",
          "name": "OpenAI Clinic Account"
        }
      }
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ JSON.parse($json.message.content).intent }}",
        "rules": {
          "rules": [
            { "value2": "book" },
            { "value2": "choose_slot" },
            { "value2": "cancel" },
            { "value2": "reschedule" },
            { "value2": "escalate" },
            { "value2": "info" }
          ]
        }
      },
      "id": "node-4-switch-intent",
      "name": "4. Switch Intent Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [780, 300]
    },
    {
      "parameters": {
        "calendar": "={{ $env.DOCTOR_CALENDAR_ID || 'dr.mehta.clinic@gmail.com' }}",
        "operation": "getAll",
        "options": {
          "timeMin": "={{ JSON.parse($('3. OpenAI AI Agent (Hinglish/English)').item.json.message.content).preferred_date || $now.format('YYYY-MM-DD') }}T00:00:00Z",
          "timeMax": "={{ JSON.parse($('3. OpenAI AI Agent (Hinglish/English)').item.json.message.content).preferred_date || $now.format('YYYY-MM-DD') }}T23:59:59Z"
        }
      },
      "id": "node-5-calendar-get-events",
      "name": "5. Google Calendar: Fetch Doctor Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1,
      "position": [1020, 200],
      "credentials": {
        "googleCalendarOAuth2": {
          "id": "google-calendar-clinic-cred",
          "name": "Google Calendar Clinic Account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Compute free 30-min slots between 10:00 and 17:30\nconst events = $input.all();\nconst workingStart = 10 * 60; // 10:00 AM\nconst workingEnd = 17.5 * 60; // 5:30 PM\nconst slotDuration = 30;\n\nconst bookedIntervals = events.map(e => {\n  const s = new Date(e.json.start.dateTime || e.json.start.date);\n  const end = new Date(e.json.end.dateTime || e.json.end.date);\n  return { start: s.getHours() * 60 + s.getMinutes(), end: end.getHours() * 60 + end.getMinutes() };\n});\n\nconst freeSlots = [];\nfor (let min = workingStart; min + slotDuration <= workingEnd; min += slotDuration) {\n  const slotEnd = min + slotDuration;\n  const isClash = bookedIntervals.some(b => Math.max(min, b.start) < Math.min(slotEnd, b.end));\n  if (!isClash) {\n    const h = Math.floor(min / 60);\n    const m = min % 60;\n    const ampm = h >= 12 ? 'PM' : 'AM';\n    const displayH = h % 12 === 0 ? 12 : h % 12;\n    freeSlots.push(`${displayH}:${m.toString().padStart(2, '0')} ${ampm}`);\n  }\n}\n\nreturn [{ json: { freeSlots, freeSlotsText: freeSlots.slice(0, 4).join(', ') } }];"
      },
      "id": "node-6-code-compute-slots",
      "name": "6. Code: Compute Free Slots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 200]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_NUMBER_ID }}/messages",
        "options": {},
        "bodyParametersUi": {
          "parameter": [
            { "name": "messaging_product", "value": "whatsapp" },
            { "name": "to", "value": "={{ $('1. WhatsApp Webhook Trigger').item.json.body.entry[0].changes[0].value.messages[0].from }}" },
            { "name": "type", "value": "text" },
            { "name": "text", "value": "={{ { body: 'Dr. Mehta ke khali timings: ' + $json.freeSlotsText + '. Kripya apna slot select karein.' } }}" }
          ]
        }
      },
      "id": "node-7-whatsapp-send-slots",
      "name": "7. WhatsApp: Send Free Slots Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
