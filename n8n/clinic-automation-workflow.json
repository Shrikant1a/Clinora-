        "start": "={{ $('3. OpenAI AI Agent (Hinglish/English)').item.json.preferred_date || $now.format('YYYY-MM-DD') }}T11:30:00+05:30",
        "end": "={{ $('3. OpenAI AI Agent (Hinglish/English)').item.json.preferred_date || $now.format('YYYY-MM-DD') }}T12:00:00+05:30",
        "summary": "={{ JSON.parse($('3. OpenAI AI Agent (Hinglish/English)').item.json.message.content).patient_name || 'Patient' }} - {{ JSON.parse($('3. OpenAI AI Agent (Hinglish/English)').item.json.message.content).problem || 'Consultation' }}",
        "description": "=Phone: {{ $('1. WhatsApp Webhook Trigger').item.json.body.entry[0].changes[0].value.messages[0].from }}\nSource: WhatsApp AI\nBooked via Clinic Automation"
      },
